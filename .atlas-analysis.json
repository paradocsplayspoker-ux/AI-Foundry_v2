  "keyFeatures": [
    "Multi-agent AI team with configurable roles, prompts, and permissions",
    "Real persistent IDE with Monaco editor and project filesystem",
    "Integrated terminal for executing real development commands",
    "Support for multiple AI providers (OpenAI, Anthropic, Gemini, Groq, xAI, OpenRouter, and more)",
    "Turn-based and autonomous multi-agent orchestration",
    "Agent-to-agent communication and collaboration",
    "Structured debate, research, and code-review orchestration modes",
    "Real-time activity streaming via SSE/WebSockets",
    "Per-agent permission matrix (read/write/execute/network)",
    "Diff review and file version snapshots for agent-proposed changes",
    "Credential isolation — API keys never exposed to the browser",
    "Project isolation with path-traversal prevention"
  ],
  "publicApiSurface": [
